# Copiar a deploy/.env y completar. deploy/.env NUNCA va a git.

# --- Infra ---
CF_TUNNEL_TOKEN=
ASPNETCORE_ENVIRONMENT=Production

# --- Postgres ---
# La connection string de la app se arma sola con estas tres (ver docker-compose.yml).
# Generar la contraseña con: openssl rand -hex 24   (solo letras y números, no rompe la connection string)
POSTGRES_DB=lab3
POSTGRES_USER=lab3
POSTGRES_PASSWORD=

# --- APIs externas ---
# TMDB: themoviedb.org → Settings → API → "API Read Access Token" (el largo, empieza con eyJ).
Tmdb__ReadAccessToken=
# YouTube Data API v3: console.cloud.google.com → Credenciales → API key restringida a esa API.
YouTube__ApiKey=

# --- SMTP (opcional, solo para "Olvidé mi contraseña") ---
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=

# --- Datos de demo (opcional, para la entrega) ---
# Con Demo__Seed=true crea 3 usuarios demo (cinefila, seriero, otaku_ar) con reviews y listas.
Demo__Seed=false
Demo__Password=
