@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Olvidé mi contraseña";
    var smtpEnabled = ViewData["SmtpEnabled"] as bool? ?? false;
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-4">Olvidé mi contraseña</h1>
        @if (!smtpEnabled)
        {
            <div class="alert alert-info">
                La recuperación por mail todavía no está habilitada en este sitio.
                Si no podés entrar, pedile al administrador que te ayude.
            </div>
            <a href="/cuenta/login">Volver a entrar</a>
        }
        else
        {
            <p class="text-body-secondary">Te mandamos un enlace para elegir una contraseña nueva.</p>
            <form method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-warning w-100">Mandar enlace</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
