@model ProfileViewModel
@{
    ViewData["Title"] = "Editar perfil";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-4">Editar perfil</h1>

        <dl class="row small mb-4">
            <dt class="col-4 text-body-secondary">Usuario</dt>
            <dd class="col-8"><a href="/usuario/@Model.UserName">@Model.UserName</a></dd>
            <dt class="col-4 text-body-secondary">Mail</dt>
            <dd class="col-8">@Model.Email</dd>
        </dl>

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" />
                <span asp-validation-for="DisplayName" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Bio" class="form-label"></label>
                <textarea asp-for="Bio" class="form-control" rows="4" maxlength="500"></textarea>
                <span asp-validation-for="Bio" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-warning">Guardar</button>
            <a class="btn btn-outline-secondary ms-2" href="/cuenta/contrasena">Cambiar contraseña</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
