@model UserProfileViewModel
@{
    ViewData["Title"] = $"{Model.DisplayName} (@{Model.UserName})";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <div class="avatar rounded-circle" aria-hidden="true">@Display.Initials(Model.DisplayName)</div>
    <div class="flex-grow-1">
        <h1 class="h3 mb-0">@Model.DisplayName</h1>
        <div class="text-body-secondary">@@@Model.UserName · miembro desde @Display.Date(Model.CreatedAt)</div>
    </div>
    @if (Model.IsMe)
    {
        <a class="btn btn-outline-secondary btn-sm" href="/cuenta/perfil">Editar perfil</a>
    }
</div>

@if (Model.Bio is not null)
{
    <p class="bio mb-4">@Model.Bio</p>
}

<div class="d-flex gap-4 mb-4 small text-body-secondary">
    <span><strong class="text-body">@Model.Reviews.Count</strong> reviews</span>
    <span><strong class="text-body">@Model.Bookmarks.Count</strong> títulos guardados</span>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#perfil-reviews" type="button" role="tab" aria-selected="true">Reviews</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#perfil-listas" type="button" role="tab" aria-selected="false">Listas</button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="perfil-reviews" role="tabpanel">
        @if (Model.Reviews.Count == 0)
        {
            <p class="text-body-secondary">Todavía no escribió reviews.</p>
        }
        else
        {
            @foreach (var r in Model.Reviews)
            {
                <partial name="_ReviewCard" model="r" view-data='new ViewDataDictionary(ViewData) { ["ShowTitle"] = true }' />
            }
        }
    </div>
    <div class="tab-pane fade" id="perfil-listas" role="tabpanel">
        @if (Model.Bookmarks.Count == 0)
        {
            <p class="text-body-secondary">Todavía no guardó títulos.</p>
        }
        else
        {
            <partial name="_BookmarkGrid" model="Model.Bookmarks" />
        }
    </div>
</div>
